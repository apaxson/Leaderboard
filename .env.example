# Supabase project settings (Project Settings -> API)
# Service role key is server-only -- never expose it to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# /admin login password.
ADMIN_PASSWORD=change-me

# Random secret used as the admin session cookie's value.
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_TOKEN=change-me-too

# Comma-separated CIDR ranges allowed to reach /admin at all (checked before
# the password). Defaults to 10.0.0.0/22 if unset.
ADMIN_ALLOWED_CIDRS=10.0.0.0/22

# Port the dev/production server listens on. Defaults to 3000 if unset.
# Next.js can't read PORT from .env directly (the HTTP server boots first), so
# the `dev` and `start` scripts load this file with `node --env-file-if-exists`
# before starting Next. A `-p` flag on the command line still wins over this.
PORT=3000
